---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import FriendCard from "../../components/FriendCard.astro";
import Pagination from "../../components/control/Pagination.astro";
import { FRIENDS_PAGE_SIZE } from "../../constants/constants";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { friendsConfig } from "../../config";

export const getStaticPaths = (async ({ paginate }) => {
	return paginate(friendsConfig.links, { pageSize: FRIENDS_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const len = page.data.length;
const total = friendsConfig.links.length;

let delay = 0;
const interval = 40;
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <!-- page header -->
    <div class="card-base w-full flex items-center gap-3 px-6 py-5 mb-4 onload-animation">
        <Icon name="material-symbols:link-rounded" class="text-[var(--primary)] text-2xl"></Icon>
        <div class="font-bold text-2xl text-90">{i18n(I18nKey.friends)}</div>
        <div class="transition px-2 h-7 ml-1 min-w-[2rem] rounded-lg text-sm font-bold
            text-[var(--btn-content)] dark:text-[var(--deep-text)]
            bg-[var(--btn-regular-bg)] dark:bg-[var(--primary)]
            flex items-center justify-center">
            {total}
        </div>
        {page.lastPage > 1 && <div class="ml-auto text-sm text-50 transition">{page.currentPage} / {page.lastPage}</div>}
    </div>

    {len > 0 && <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        {page.data.map((link) => (
            <FriendCard
                name={link.name}
                url={link.url}
                avatar={link.avatar}
                description={link.description}
                class="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
            ></FriendCard>
        ))}
    </div>}

    {len === 0 && <div class="card-base w-full flex flex-col items-center justify-center gap-3 py-12 mb-4 onload-animation">
        <Icon name="material-symbols:link-off-rounded" class="text-4xl text-50"></Icon>
        <div class="text-75 transition">{i18n(I18nKey.friendsEmpty)}</div>
    </div>}

    {page.lastPage > 1 && <Pagination
        base="/friends"
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * interval}ms);`}
    ></Pagination>}
</MainGridLayout>
