---
// 无需前端框架，纯客户端脚本
---

<div class="pointer">
  <div></div>
  <div></div>
  <div></div>
  <div></div>
</div>

<style>
  .pointer {
    --width: 2rem;
    --height: 2rem;
    position: fixed;
    top: calc(var(--height) / -2);
    left: calc(var(--width) / -2);
    width: var(--width);
    height: var(--height);
    transition: transform 0.2s ease-out, top 0.2s ease-out, left 0.2s ease-out, width 0.2s ease-out, height 0.2s ease-out ;
    pointer-events: none;
    z-index: 9999;
  }

  .pointer div {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-width: 0.2rem;
    border-color: #c35e5b;
  }

  .pointer div:nth-child(1) {
    top: 0;
    left: 0;
    border-right: none;
    border-bottom: none;
  }

  .pointer div:nth-child(2) {
    top: 0;
    right: 0;
    border-left: none;
    border-bottom: none;
  }

  .pointer div:nth-child(3) {
    bottom: 0;
    left: 0;
    border-top: none;
    border-right: none;
  }

  .pointer div:nth-child(4) {
    bottom: 0;
    right: 0;
    border-top: none;
    border-left: none;
  }
</style>

<script>
  // ⚠️ 必须用 client-side 执行
  const pointer = {
    container: null,
    current_target: null,

    init() {
      this.container = document.querySelector(".pointer");
      window.addEventListener("mousemove", this.move.bind(this));
      window.addEventListener("touchmove", this.touchMove.bind(this), { passive: true });
      window.addEventListener("touchstart", this.touchMove.bind(this), { passive: true });
      this.bind_targets_events();
    },

    move(e) {
      if (!this._boundOnce || document.querySelectorAll(".mp_target").length !== this._lastCount) {
        this.bind_targets_events();
        this._boundOnce = true;
        this._lastCount = document.querySelectorAll(".mp_target").length;
      }
      let x = e.clientX;
      let y = e.clientY;

      if (this.current_target) {
        const rect = this.current_target.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;

        x = cx + (x - cx) * 0.1;
        y = cy + (y - cy) * 0.1;
      }

      this.container.style.transform = `translate(${x}px, ${y}px)`;
    },

    touchMove(e) {
      if (!e.touches || e.touches.length === 0) return;

      const touch = e.touches[0];

      let x = touch.clientX;
      let y = touch.clientY;

      if (this.current_target) {
        // 👇 如果元素已经被移除，直接取消 target
        if (!document.body.contains(this.current_target)) {
          this.current_target = null;

          this.container.style.setProperty("--width", "2rem");
          this.container.style.setProperty("--height", "2rem");
        } else {
          const rect = this.current_target.getBoundingClientRect();

          // 👇 防止 0,0 bug
          if (rect.width === 0 || rect.height === 0) {
            this.current_target = null;
          } else {
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;

            x = cx + (x - cx) * 0.1;
            y = cy + (y - cy) * 0.1;
          }
        }
      }

      this.container.style.transform = `translate(${x}px, ${y}px)`;
    },

    bind_targets_events() {
      const targets = document.querySelectorAll(".mp_target");

      targets.forEach(ele => {
        // ✅ 避免重复绑定（关键）
        if (ele._mp_bound) return;
        ele._mp_bound = true;

        // ===== 抽象 enter =====
        const enter = () => {
          const rect = ele.getBoundingClientRect();

          // ✅ 防止 hidden / display:none
          if (rect.width === 0 || rect.height === 0) return;

          this.current_target = ele;

          this.container.style.setProperty(
            "--width",
            rect.width + window.innerWidth / 100 + "px"
          );
          this.container.style.setProperty(
            "--height",
            rect.height + window.innerWidth / 100 + "px"
          );
        };

        // ===== 抽象 leave =====
        const leave = () => {
          this.current_target = null;

          this.container.style.setProperty("--width", "2rem");
          this.container.style.setProperty("--height", "2rem");
        };

        // ===== PC =====
        ele.addEventListener("mouseenter", enter);
        ele.addEventListener("mouseleave", leave);

        // ===== 移动端 =====
        ele.addEventListener("touchstart", enter, { passive: true });
        ele.addEventListener("touchend", leave, { passive: true });

        ele.addEventListener("click", (e) => {
          const link = ele.closest("a");

          // 👉 只有真正跳转的链接才触发 leave
          if (link && link.getAttribute("href") && link.getAttribute("href") !== "#") {
            leave();
          }
        });
      });
    }
  };

  // ✅ Astro 推荐：DOMContentLoaded 后执行
  window.addEventListener("DOMContentLoaded", () => {
    pointer.init();
  });
</script>