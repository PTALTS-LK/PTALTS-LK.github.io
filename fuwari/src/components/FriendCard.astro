---
import { Icon } from "astro-icon/components";

interface Props {
	name: string;
	url: string;
	avatar?: string;
	description?: string;
	class?: string;
	style?: string;
}

const { name, url, avatar, description, style } = Astro.props;
const className = Astro.props.class;

const hasAvatar = typeof avatar === "string" && avatar !== "";
const hasDescription = typeof description === "string" && description !== "";
---

<a href={url} target="_blank" rel="noopener noreferrer" aria-label={name}
   class:list={[
       "card-base group relative flex items-center gap-4 p-4 w-full h-full",
       "hover:bg-[var(--btn-card-bg-hover)] active:bg-[var(--btn-card-bg-active)] active:scale-[0.98]",
       className,
   ]}
   style={style}
>
    <!-- avatar -->
    <div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-[var(--btn-regular-bg)]">
        <Icon name="material-symbols:person-rounded"
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-3xl text-[var(--btn-content)] dark:text-white/40">
        </Icon>
        {hasAvatar && <img
            src={avatar}
            alt={`${name}'s avatar`}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="relative w-full h-full object-cover transition duration-300 group-hover:scale-105"
            onerror="this.style.display='none'"
        />}
    </div>

    <!-- name and description -->
    <div class="flex flex-col justify-center gap-1 min-w-0 flex-1">
        <div class="flex items-center min-w-0 font-bold text-xl text-90 transition group-hover:text-[var(--primary)]">
            <span class="truncate">{name}</span>
            <Icon name="fa6-solid:arrow-up-right-from-square"
                  class="shrink-0 ml-2 text-xs text-black/[0.2] dark:text-white/[0.2] transition group-hover:text-[var(--primary)]">
            </Icon>
        </div>
        {hasDescription && <div class="text-sm text-75 line-clamp-2 transition">{description}</div>}
    </div>

    <!-- hover indicator -->
    <Icon name="material-symbols:chevron-right-rounded"
          class="shrink-0 text-[var(--primary)] text-3xl transition opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0">
    </Icon>
</a>
